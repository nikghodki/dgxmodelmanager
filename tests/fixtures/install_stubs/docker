#!/usr/bin/env bash
# Fake docker CLI for tests/test_install_script.py. Behaviour is driven by FAKE_* env vars and
# every invocation is appended to $FAKE_LOG.
# shellcheck disable=SC2086  # FAKE_MANAGED_IDS is split into one id per line on purpose
echo "docker $*" >> "${FAKE_LOG:-/dev/null}"
case "$*" in
  "info --format {{json .Runtimes}}")
    case "${FAKE_DAEMON:-up}" in
      down) echo "Cannot connect to the Docker daemon at unix:///var/run/docker.sock." >&2; exit 1 ;;
      denied) echo "permission denied while trying to connect to the Docker daemon socket" >&2; exit 1 ;;
    esac
    default_rt='{"nvidia":{"path":"nvidia-container-runtime"},"runc":{"path":"runc"}}'
    echo "${FAKE_RUNTIMES:-$default_rt}" ;;
  "version --format {{.Server.Version}}") echo "${FAKE_SERVER_VERSION:-29.2.1}" ;;
  "compose version --short") [ "${FAKE_COMPOSE:-ok}" = ok ] || { echo "docker: 'compose' is not a docker command." >&2; exit 1; }; echo "2.40.0" ;;
  "inspect --format {{.State.Status}}|{{index .Config.Labels \"com.docker.compose.project.working_dir\"}} dgxmm")
    [ -n "${FAKE_DGXMM_STATE:-}" ] || { echo "Error: No such object: dgxmm" >&2; exit 1; }
    echo "${FAKE_DGXMM_STATE}|${FAKE_DGXMM_WORKDIR:-}" ;;
  "inspect --format {{.State.Status}}/{{if .State.Health}}{{.State.Health.Status}}{{end}} dgxmm")
    echo "${FAKE_HEALTH:-running/healthy}" ;;
  "logs dgxmm"|"logs --tail 40 dgxmm") printf '%s\n' "${FAKE_LOGS:-}" ;;
  logs\ --since\ *\ dgxmm) [ "${FAKE_LOGS_OLD:-0}" = 1 ] || printf '%s\n' "${FAKE_LOGS:-}" ;;
  "inspect --format {{.Id}} dgxmm")
    if [ -f "$FAKE_LOG.id" ]; then cat "$FAKE_LOG.id"
    elif [ -n "${FAKE_DGXMM_STATE:-}" ]; then echo "old-id"
    else exit 1; fi ;;
  "compose up -d --build"|"compose --profile litellm up -d --build")
    echo "COMPOSE_PROFILES=${COMPOSE_PROFILES-<unset>}" >> "$FAKE_LOG.profiles"
    echo "DGXMM_PID_MODE=${DGXMM_PID_MODE-<unset>}" >> "$FAKE_LOG.profiles"
    [ "${FAKE_COMPOSE_UP:-ok}" = fail ] && { echo "failed to solve: process did not complete" >&2; exit 17; }
    [ "${FAKE_RECREATE:-1}" = 1 ] && echo "id-$RANDOM-$$" > "$FAKE_LOG.id"
    case "$*" in
      *litellm*)
        # fail-litellm: dgxmm starts, but the LiteLLM database never becomes healthy.
        [ "${FAKE_COMPOSE_UP:-ok}" = fail-litellm ] && { echo "dependency failed to start: container dgxmm-litellm-db is unhealthy" >&2; exit 1; }
        touch "$FAKE_LOG.bundled" ;;
    esac ;;
  "compose --profile litellm logs --tail 30 dgxmm-litellm-db dgxmm-litellm") printf '%s\n' "${FAKE_LITELLM_LOGS:-}" ;;
  "inspect --format {{.RestartCount}} id-dgxmm-litellm") echo "${FAKE_LITELLM_RESTARTS:-0}" ;;
  ps\ -aq\ --filter\ label=com.docker.compose.project.working_dir=*\ --filter\ label=com.docker.compose.service=*)
    # Bundled LiteLLM containers exist after a profile up, or when FAKE_BUNDLED=1.
    if [ -e "$FAKE_LOG.bundled" ] || [ "${FAKE_BUNDLED:-0}" = 1 ]; then last=${!#}; echo "id-${last##*service=}"; fi ;;
  "inspect --format {{.State.Status}}/{{if .State.Health}}{{.State.Health.Status}}{{end}} id-dgxmm-litellm")
    echo "${FAKE_LITELLM_HEALTH:-running/healthy}" ;;
  "inspect --format {{.Name}}"*" id-"*) last=${!#}; echo "/repo-${last#id-}-1  running (healthy)" ;;
  pull\ *) [ "${FAKE_PULL:-ok}" = ok ] || { echo "manifest unknown" >&2; exit 1; } ;;
  network\ inspect\ *\ -f\ *Gateway*) [ "${FAKE_NETWORK:-missing}" = exists ] || { echo "Error: No such network" >&2; exit 1; }; echo "172.99.0.1" ;;
  network\ inspect\ --format*dgxmm.install*) [ "${FAKE_DECIDER_NET:-missing}" = exists ] || exit 1; echo "${FAKE_DECIDER_NET_INSTALL-zz99yy88xx77}" ;;
  network\ inspect\ --format*dgxmm.purpose*) [ "${FAKE_DECIDER_NET:-missing}" = exists ] || exit 1; echo "${FAKE_DECIDER_NET_PURPOSE-decider}" ;;
  network\ inspect\ --format*) [ "${FAKE_NETWORK:-missing}" = exists ] || exit 1; echo "${FAKE_NETWORK_LABEL:-}" ;;
  network\ inspect*) [ "${FAKE_NETWORK:-missing}" = exists ] || { echo "Error: No such network" >&2; exit 1; } ;;
  "ps -aq --filter label=dgxmm.managed=true"|"ps -q --filter label=dgxmm.managed=true") printf '%s\n' ${FAKE_MANAGED_IDS:-} ;;
  ps\ -aq\ --filter\ label=dgxmm.managed=true\ --filter\ label=dgxmm.install=*) printf '%s\n' ${FAKE_OWN_MANAGED_IDS:-} ;;
  ps\ --filter\ label=dgxmm.managed=true*) printf '%s\n' ${FAKE_MANAGED_IDS:-} ;;
  "ps -q --filter name=^litellm-proxy$") [ -n "${FAKE_LITELLM:-}" ] && echo "abc123" ;;
  exec\ litellm-proxy*) echo "${FAKE_LITELLM_KEY:-sk-fake-master}" ;;
  "inspect --format {{json .NetworkSettings.Networks}} litellm-proxy") echo "{\"${FAKE_LITELLM_NET:-gateway}\":{}}" ;;
  # --- decision model (./install.sh --with-decider) ---
  exec\ *dgxmm\ python\ -m\ dgxmm.admin\ decider\ *)
    all="$*"; sub=${all#*dgxmm.admin decider }; sub=${sub%% *}
    echo "fake-cli decider $sub"
    case $sub in
      build) rc=${FAKE_DECIDER_BUILD_RC:-0} ;;
      download) rc=${FAKE_DECIDER_DOWNLOAD_RC:-0} ;;
      enable) rc=${FAKE_DECIDER_ENABLE_RC:-0}; [ "$rc" = 3 ] && echo "The decider does not fit: it needs 13.0 GiB" ;;
      disable) rc=${FAKE_DECIDER_DISABLE_RC:-0} ;;
      status) echo "Decision model: ${FAKE_DECIDER_STATUS:-enabled, healthy (ready, deployment 3)}"; rc=${FAKE_DECIDER_STATUS_RC:-0} ;;
      admin-disabled) rc=${FAKE_DECIDER_ADMIN_DISABLED:-1} ;;
      *) rc=0 ;;
    esac
    exit "$rc" ;;
  "ps -q --filter label=dgxmm.system=true --filter status=running") printf '%s\n' ${FAKE_DECIDER_RUNNING:-} ;;
  "ps -aq --filter label=dgxmm.system=true") printf '%s\n' ${FAKE_DECIDER_ALL_IDS:-${FAKE_DECIDER_IDS:-}} ;;
  ps\ -aq\ --filter\ label=dgxmm.system=true\ --filter\ label=dgxmm.install=*) printf '%s\n' ${FAKE_DECIDER_IDS:-} ;;
  "ps -a --filter label=dgxmm.system=true --format {{.Names}}  {{.Status}}")
    for i in ${FAKE_DECIDER_IDS:-}; do echo "dgxmm-decider-$i  Up 2 hours"; done ;;
  image\ inspect\ dgxmm-decider*|image\ inspect\ custom-decider*) [ "${FAKE_DECIDER_IMAGE:-missing}" = present ] || { echo "Error: No such image" >&2; exit 1; } ;;
  images\ --filter\ label=dgxmm.built=true\ --filter\ label=dgxmm.install=*)
    for r in ${FAKE_BUILT_REFS:-}; do
      case $r in "<none>:<none>@"*) echo "<none>:<none> ${r#*@}" ;; *) echo "$r sha256:${#r}" ;; esac
    done ;;
  "info --format {{.DockerRootDir}}") echo "${FAKE_DOCKER_ROOT:-/}" ;;
  *) : ;;
esac
exit 0
